generator client {
  provider = "prisma-client-js"     // generates the TypeScript client
}
datasource db {
  provider = "postgresql"
}
enum TransactionType {
  credit
  debit
}
model Account {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String        @db.VarChar(150)
  balance      Decimal       @default(0) @db.Decimal(19, 4)
  currency     String        @default("INR") @db.Char(3)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  transactions Transaction[]  

  @@map("accounts")
}
model Transaction {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId    String         @map("account_id")
  type         TransactionType
  amount       Decimal         @db.Decimal(19, 4)
  description  String?         @db.VarChar(255)
  balanceAfter Decimal         @map("balance_after") @db.Decimal(19, 4)
  referenceId  String          @map("reference_id") @db.VarChar(100)
  createdAt    DateTime        @default(now()) @map("created_at")
  account      Account         @relation(fields: [accountId], references: [id])

  @@unique([accountId, referenceId])
  @@index([accountId, createdAt(sort: Desc)])
  @@map("transactions")
}